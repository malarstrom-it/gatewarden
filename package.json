{
  "name": "@malarstrom/gatewarden",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Give a local development server an https address on your own domain: an MCP server, a pi extension, a CLI and an Agent Skill over one proxy-agnostic core",
  "repository": {
    "type": "git",
    "url": "git+https://gitea.home.malarstrom.com/malarstrom/traefik-api.git"
  },
  "homepage": "https://gitea.home.malarstrom.com/malarstrom/traefik-api",
  "bugs": {
    "url": "https://gitea.home.malarstrom.com/malarstrom/traefik-api/issues"
  },
  "author": {
    "name": "malarstrom"
  },
  "funding": {
    "type": "individual",
    "url": "https://gitea.home.malarstrom.com/malarstrom"
  },
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js",
      "default": "./dist/adapters/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "adapters": [
        "./dist/adapters/index.d.ts"
      ]
    }
  },
  "bin": {
    "gatewarden": "bin/gatewarden.js",
    "gatewarden-mcp": "bin/gatewarden-mcp.js",
    "gatewarden-daemon": "bin/gatewarden-daemon.js"
  },
  "files": [
    "dist",
    "bin/gatewarden.js",
    "bin/gatewarden-mcp.js",
    "bin/gatewarden-daemon.js",
    "bin/entry.mjs",
    "scripts",
    "skills",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "test:e2e": "node tools/testenv/run.ts",
    "test:e2e:stop": "node tools/testenv/stop.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test",
    "publish:dry-run": "npm publish --dry-run",
    "postinstall": "node scripts/postinstall.mjs",
    "start": "node src/daemon.ts"
  },
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "env-paths": "^3.0.0",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^22.10.0",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^5.7.0"
  },
  "pi": {
    "extensions": [
      "dist/integrations/pi/extension.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "keywords": [
    "pi-package",
    "mcp",
    "gatewarden",
    "gateway",
    "dev-server",
    "local-development",
    "https",
    "traefik"
  ]
}
