{
  "name": "@malarstrom/agent-dev-gateway",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Publish a development server running on this machine to an address the user can open in a browser: an MCP server, a pi extension, a CLI and an Agent Skill over one proxy-agnostic core",
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": "./dist/core/index.js",
    "./adapters": "./dist/adapters/index.js"
  },
  "bin": {
    "dev-gateway": "bin/dev-gateway.js",
    "dev-gateway-mcp": "bin/dev-gateway-mcp.js",
    "dev-gateway-daemon": "bin/dev-gateway-daemon.js"
  },
  "files": [
    "dist",
    "bin/dev-gateway.js",
    "bin/dev-gateway-mcp.js",
    "bin/dev-gateway-daemon.js",
    "bin/entry.mjs",
    "scripts",
    "skills",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "test:e2e": "node tools/testenv/run.ts",
    "test:e2e:stop": "node tools/testenv/stop.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test",
    "publish:dry-run": "npm publish --dry-run",
    "postinstall": "node scripts/postinstall.mjs",
    "start": "node src/daemon.ts"
  },
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "env-paths": "^3.0.0",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^22.10.0",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^5.7.0"
  },
  "pi": {
    "extensions": ["dist/integrations/pi/extension.js"],
    "skills": ["./skills"]
  },
  "keywords": [
    "pi-package",
    "mcp",
    "traefik",
    "dev-server",
    "agent"
  ]
}
