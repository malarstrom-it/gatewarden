{
  "name": "traefik-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Container side of the Traefik dev gateway: registry, relay and CLI for agent dev servers",
  "bin": {
    "dev-gateway": "bin/dev-gateway.js",
    "traefik-dev": "bin/traefik-dev.js",
    "traefik-devd": "bin/traefik-devd.js"
  },
  "files": [
    "dist",
    "bin",
    "skills",
    "docs",
    "README.md"
  ],
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && npm test",
    "start": "node src/daemon.ts"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "dependencies": {
    "env-paths": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
